# ============================================================
# Agentic AIOps RCA Copilot - Environment Configuration
# ============================================================

# Google Gemini API Key (Required for LangGraph correlation & synthesis)
# Obtain a free-tier key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Target Microservices Ports
ORDER_SERVICE_PORT=8001
PAYMENT_SERVICE_PORT=8002

# Observability Ports
OTEL_COLLECTOR_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000

# RCA Copilot Backend & UI Ports
COPILOT_BACKEND_PORT=8000
STREAMLIT_PORT=8501

# Telemetry Internal Network URLs (Inside Docker Network)
PROMETHEUS_URL=http://prometheus:9090
TEMPO_URL=http://tempo:3200
LOKI_URL=http://loki:3100
ALERTMANAGER_URL=http://alertmanager:9093
COPILOT_BACKEND_URL=http://copilot-backend:8000

# Host Telemetry URLs (For local script executions & Streamlit on host)
HOST_PROMETHEUS_URL=http://localhost:9090
HOST_TEMPO_URL=http://localhost:3200
HOST_LOKI_URL=http://localhost:3100
HOST_ALERTMANAGER_URL=http://localhost:9093
HOST_COPILOT_BACKEND_URL=http://localhost:8000
HOST_ORDER_SERVICE_URL=http://localhost:8001
HOST_PAYMENT_SERVICE_URL=http://localhost:8002

# Rate Limiter & Token Safeguards
MAX_RPM_CALLS=10
LLM_RETRY_BACKOFF_SECONDS=5
